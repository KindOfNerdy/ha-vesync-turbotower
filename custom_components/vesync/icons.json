      "water_tank_lifted": {
        "default": "mdi:cup-water"
      }
    },
    "button": {
      "reset_filter": {
        "default": "mdi:air-filter"
      },
      "zone_start": {
        "default": "mdi:play"
      },
      "zone_stop": {
        "default": "mdi:stop"
      },
      "zone_pause_resume": {
        "default": "mdi:play-pause"
      },
      "start_both": {
        "default": "mdi:play-box-multiple"
