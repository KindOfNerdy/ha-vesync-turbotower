    "start_cook": {
      "name": "Start cooking",
      "description": "Starts one or both zones of a dual-zone air fryer. Temperature and time default to the program's preset stored in the fryer.",
      "fields": {
        "device_id": {
          "name": "Air fryer",
          "description": "Leave empty if you have only one Turbo Tower."
        },
        "zone": {
          "name": "Zone",
          "description": "1 (top), 2 (bottom) or both zones."
        },
        "program": {
          "name": "Program",
          "description": "Cooking program (for both zones: zone 1)."
        },
        "temperature": {
          "name": "Temperature",
          "description": "Leave empty to use the program's preset."
        },
        "duration": {
          "name": "Time",
          "description": "Cooking time in minutes. Leave empty to use the program's preset."
        },
        "confirm_on_device": {
          "name": "Confirm start on device",
          "description": "Only send the program and start it with the button on the fryer. Leave empty to use the switch setting."
        },
        "mode": {
          "name": "Mode for both zones",
          "description": "Independent: each zone on its own time. Sync: both finish together. Match: zone 2 uses the values of zone 1."
        },
        "program_2": {
          "name": "Program zone 2",
          "description": "Only for independent or sync."
        },
        "temperature_2": {
          "name": "Temperature zone 2",
          "description": "Leave empty to use the program's preset."
        },
        "duration_2": {
          "name": "Time zone 2",
          "description": "Cooking time in minutes. Leave empty to use the program's preset."
        }
      },
      "sections": {
        "zone_2": {
          "name": "Both zones",
          "description": "Only needed when starting both zones."
        }
      }
    },
    "stop": {
      "name": "Stop cooking",
      "description": "Ends cooking in one or all zones. When no zone is left, the fryer switches off.",
      "fields": {
        "device_id": {
          "name": "Air fryer",
          "description": "Leave empty if you have only one Turbo Tower."
        },
        "zone": {
          "name": "Zone",
          "description": "Which zone: 1 (top), 2 (bottom) or all."
        }
      }
    },
    "pause": {
      "name": "Pause",
      "description": "Pauses cooking zones.",
      "fields": {
        "device_id": {
          "name": "Air fryer",
          "description": "Leave empty if you have only one Turbo Tower."
        },
        "zone": {
          "name": "Zone",
          "description": "Which zone: 1 (top), 2 (bottom) or all."
        }
      }
    },
    "resume": {
      "name": "Resume",
      "description": "Resumes paused zones.",
      "fields": {
        "device_id": {
          "name": "Air fryer",
