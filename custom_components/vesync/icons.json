      "stop_all": {
        "default": "mdi:stop-circle"
      },
      "pause_resume_all": {
        "default": "mdi:play-pause"
      }
    },
    "fan": {
      "vesync": {
        "state_attributes": {
          "preset_mode": {
            "state": {
              "advanced_sleep": "mdi:sleep",
              "auto": "mdi:fan-auto",
              "eco": "mdi:leaf",
              "pet": "mdi:paw",
              "sleep": "mdi:sleep",
              "turbo": "mdi:weather-tornado"
            }
          }
        }
      }
    },
    "number": {
      "mist_level": {
        "default": "mdi:water-percent"
      },
      "warm_mist_level": {
        "default": "mdi:heat-wave"
      },
      "zone_temperature": {
        "default": "mdi:thermometer"
      },
      "zone_time": {
        "default": "mdi:timer-outline"
      }
    },
    "switch": {
      "auto_off_config": {
        "default": "mdi:timer-off"
      },
      "child_lock": {
        "default": "mdi:lock"
      },
      "display": {
        "default": "mdi:monitor"
      },
      "drying_mode_power_off": {
        "default": "mdi:weather-windy"
      },
      "confirm_on_device": {
        "default": "mdi:gesture-tap-button"
      }
    },
    "sensor": {
      "zone_status": {
        "default": "mdi:toaster-oven",
        "state": {
          "cooking": "mdi:fire",
          "paused": "mdi:pause-circle-outline",
          "waiting": "mdi:timer-sand",
          "basket_out": "mdi:tray-arrow-up",
          "done": "mdi:check-circle-outline",
          "ready": "mdi:gesture-tap-button"
        }
      },
      "zone_end_time": {
        "default": "mdi:timer-check-outline"
      },
      "fryer_mode": {
        "default": "mdi:sync"
      }
    },
    "select": {
      "zone_program": {
        "default": "mdi:chef-hat",
        "state": {
          "airfry": "mdi:fan",
          "bake": "mdi:cupcake",
          "roast": "mdi:food-drumstick",
          "grill": "mdi:grill",
          "reheat": "mdi:pot-steam",
          "dry": "mdi:fruit-cherries",
          "proof": "mdi:bread-slice"
        }
      },
      "start_mode": {
        "default": "mdi:sync"
      }
    },
    "event": {
      "zone_event": {
        "default": "mdi:bell-ring-outline"
      }
    }
  },
  "services": {
    "update_devices": {
      "service": "mdi:update"
    },
    "start_cook": {
      "service": "mdi:play"
    },
    "stop": {
      "service": "mdi:stop"
    },
    "pause": {
      "service": "mdi:pause"
    },
    "resume": {
      "service": "mdi:play-pause"
    },
    "quit_sync": {
      "service": "mdi:sync-off"
    },
    "set_preset": {
      "service": "mdi:content-save-edit"
    },
    "reset_preset": {
      "service": "mdi:restore"
    }
