  "services": {
    "update_devices": {
      "description": "Adds new VeSync devices to Home Assistant.",
      "name": "Update devices"
    },
    "start_cook": {
      "name": "Start cooking",
      "description": "Starts one or both baskets of a dual-basket air fryer with the given values. Temperature and time default to the program's preset stored in the fryer.",
      "fields": {
        "device_id": {
          "name": "Air fryer",
          "description": "Leave empty if you have only one air fryer."
        },
        "basket": {
          "name": "Basket",
          "description": "1 (top), 2 (bottom) or both baskets."
        },
        "program": {
          "name": "Program",
          "description": "Cooking program (for both baskets: basket 1)."
        },
        "temperature": {
          "name": "Temperature",
          "description": "Leave empty to use the program's preset."
        },
        "duration": {
          "name": "Time",
          "description": "Cooking time in minutes. Leave empty to use the program's preset."
        },
        "send_only": {
          "name": "Only send to fryer",
          "description": "Send the program without starting it; start it with the button on the fryer."
        },
        "mode": {
          "name": "Mode for both baskets",
          "description": "Separate: each basket on its own time. Sync: both finish together. Match: basket 2 uses the values of basket 1."
        },
        "program_2": {
          "name": "Program basket 2",
          "description": "Only for separate or sync."
        },
        "temperature_2": {
          "name": "Temperature basket 2",
          "description": "Leave empty to use the program's preset."
        },
        "duration_2": {
          "name": "Time basket 2",
          "description": "Cooking time in minutes. Leave empty to use the program's preset."
        }
      },
      "sections": {
        "basket_2": {
          "name": "Both baskets",
          "description": "Only needed when starting both baskets."
        }
      }
    },
    "set_preset": {
      "name": "Set program preset",
      "description": "Changes the temperature and time the fryer suggests for a program, also on its control panel.",
      "fields": {
        "device_id": {
          "name": "Air fryer",
          "description": "Leave empty if you have only one air fryer."
        },
        "program": {
          "name": "Program",
          "description": "Program to change."
        },
        "temperature": {
          "name": "Temperature",
          "description": "New preset temperature."
        },
        "duration": {
          "name": "Time",
          "description": "New preset time in minutes."
        }
      }
    },
    "reset_preset": {
      "name": "Reset program preset",
